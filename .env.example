# Copy to .env in this directory (bucksites/) for `netlify dev`.
# In Netlify: Site settings → Environment variables (use the same names).
# Never commit .env — it is gitignored.

# -----------------------------------------------------------------------------
# Local-only (netlify dev / localhost) — see admin-command.js
# -----------------------------------------------------------------------------
# ADMIN_SECRET=local-dev-preview
# ADMIN_PASSWORD=choose-a-local-password

# -----------------------------------------------------------------------------
# Required for production admin (Rachel Bakes GF /admin/ API auth)
# Without these, admin Netlify functions return 500 and the dashboard cannot load.
# -----------------------------------------------------------------------------
ADMIN_SECRET=
# Shared secret sent as ?secret=... in the admin URL and as header x-admin-secret.
# Use a long random string in production. Do NOT use local-dev-preview.

ADMIN_PASSWORD=
# Password for the admin unlock form; sent as x-admin-password.
# Must match what you type in the Command center password field.

# -----------------------------------------------------------------------------
# Required for live ordering data (Supabase)
# Without these, /api/ordering-status returns 500; the storefront falls back to
# ordering-config.js for open/closed UI only — forms will not persist until Supabase is set.
#
# After setting these, run SQL in docs/rachel-bakes-gf-launch-schema.sql so notification
# interests, contact messages, and extended custom-order fields persist.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional (ordering / email)
# -----------------------------------------------------------------------------
# Single config row id in Supabase (default "1")
# ORDERING_CONFIG_ROW_ID=1

# Resend — customer emails from admin (ready-for-pickup, etc.)
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=
# BAKERY_REPLY_TO_EMAIL=

# Public site URL used in emails (defaults in some functions if unset)
# NOTIFICATION_SITE_URL=https://your-site.netlify.app
